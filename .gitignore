# Whitelist .gitignore — default-deny. Ignore everything at the top level,
# then re-include only the paths that belong in the repo. New/untracked junk
# and the local dev `config/` are therefore never committed by accident.
/*

# Tracked directories
!/.github/
!/.devcontainer/
!/custom_components/
!/docs/
!/scripts/

# Tracked top-level files
!/.gitattributes
!/.gitignore
!/CHANGELOG.md
!/LICENSE
!/README.md
!/hacs.json
!/pyproject.toml
!/zensical.en.toml
!/zensical.ko.toml

# Noise inside tracked directories
__pycache__/
*.py[cod]
.DS_Store

# Agent/AI scaffolding is local-only, never tracked: AGENTS.md (and its
# CLAUDE.md / GEMINI.md symlinks) at any depth, plus .agents/ and the per-tool
# directories that link into it. The top-level `/*` rule already covers
# .agents, .claude and .gemini; this catches the nested AGENTS.md files under
# custom_components/.
AGENTS.md
CLAUDE.md
GEMINI.md
